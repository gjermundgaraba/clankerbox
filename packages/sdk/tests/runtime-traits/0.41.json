{
  "dialect": "draft-2020-12",
  "schema": {
    "$ref": "#/$defs/RuntimeTraits"
  },
  "definitions": {
    "RuntimeTraits": {
      "type": "object",
      "properties": {
        "runtime": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "images": {
          "type": "string",
          "enum": ["named", "references"]
        },
        "checkpoint": {
          "type": "string",
          "enum": ["ram", "disk"]
        },
        "captureFrom": {
          "type": "string",
          "enum": ["running", "stopped"]
        },
        "pause": {
          "type": "string",
          "enum": ["saves", "stops"]
        },
        "stop": {
          "type": "string",
          "enum": ["resumes", "discards"]
        },
        "copies": {
          "type": "string",
          "enum": ["grow", "any", "same"]
        },
        "resize": {
          "type": "object",
          "properties": {
            "running": {
              "type": "string",
              "enum": ["grow", "any", "none"]
            },
            "stopped": {
              "type": "string",
              "enum": ["grow", "any", "none"]
            }
          },
          "required": ["running", "stopped"],
          "additionalProperties": true
        },
        "sizes": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "_tag": {
                  "type": "string",
                  "enum": ["free"]
                }
              },
              "required": ["_tag"],
              "additionalProperties": true
            },
            {
              "type": "object",
              "properties": {
                "_tag": {
                  "type": "string",
                  "enum": ["classes"]
                },
                "classes": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "cpu": {
                          "type": "integer",
                          "maximum": 9007199254740991,
                          "exclusiveMinimum": 0
                        },
                        "ramMib": {
                          "type": "integer",
                          "maximum": 9007199254740991,
                          "exclusiveMinimum": 0
                        },
                        "diskGib": {
                          "type": "integer",
                          "maximum": 9007199254740991,
                          "exclusiveMinimum": 0
                        }
                      },
                      "required": ["name", "cpu", "ramMib", "diskGib"],
                      "additionalProperties": true
                    }
                  ],
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "cpu": {
                        "type": "integer",
                        "maximum": 9007199254740991,
                        "exclusiveMinimum": 0
                      },
                      "ramMib": {
                        "type": "integer",
                        "maximum": 9007199254740991,
                        "exclusiveMinimum": 0
                      },
                      "diskGib": {
                        "type": "integer",
                        "maximum": 9007199254740991,
                        "exclusiveMinimum": 0
                      }
                    },
                    "required": ["name", "cpu", "ramMib", "diskGib"],
                    "additionalProperties": true
                  }
                }
              },
              "required": ["_tag", "classes"],
              "additionalProperties": true
            }
          ]
        },
        "stopsOnItsOwn": {
          "type": "boolean"
        }
      },
      "required": [
        "runtime",
        "images",
        "checkpoint",
        "captureFrom",
        "pause",
        "stop",
        "copies",
        "resize",
        "sizes",
        "stopsOnItsOwn"
      ],
      "additionalProperties": true
    }
  }
}
