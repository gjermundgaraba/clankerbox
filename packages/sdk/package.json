{
  "name": "@gjermundgaraba/clankerbox-sdk",
  "version": "0.12.2",
  "description": "clankerbox's API contract and client library, for Effect",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gjermundgaraba/clankerbox.git",
    "directory": "packages/sdk"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./node": {
        "types": "./dist/node.d.mts",
        "import": "./dist/node.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test"
  },
  "dependencies": {
    "@gjermundgaraba/effect-actions": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@effect/platform-node": "~4.0.2",
    "effect": "~4.0.2"
  },
  "peerDependenciesMeta": {
    "@effect/platform-node": {
      "optional": true
    }
  }
}
