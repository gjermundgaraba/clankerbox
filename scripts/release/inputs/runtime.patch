+// The matching guest sends this only after sync_and_unmount_storage().
+fn is_shutdown_ack(response: &AgentResponse) -> bool {
+    matches!(response, AgentResponse::Ok { data: Some(data) }
+        if data.get("shutdown").and_then(serde_json::Value::as_bool) == Some(true))
+}
+
+#[cfg(test)]
+mod retained_shutdown_tests {
+    use super::*;
+
+    // Run in separate processes with SMOLVM_STOP_REQUIRE_ACK=1 and unset.
+    // Exercise the framed shutdown path without mutating the process environment.
+    #[test]
+    fn retained_shutdown_validates_wire_ack() {
+        let require_ack = std::env::var("SMOLVM_STOP_REQUIRE_ACK").as_deref() == Ok("1");
+        for (response, explicit_ack, is_ok) in [
+            (
+                AgentResponse::Ok {
+                    data: Some(serde_json::json!({"shutdown": true})),
+                },
+                true,
+                true,
+            ),
+            (AgentResponse::Ok { data: None }, false, true),
+            (
+                AgentResponse::Ok {
+                    data: Some(serde_json::json!({"shutdown": false})),
+                },
+                false,
+                true,
+            ),
+            (
+                AgentResponse::Pong {
+                    version: 1,
+                    capabilities: vec![],
+                },
+                false,
+                false,
+            ),
+        ] {
+            let (client_stream, mut peer) = UdsStream::pair().unwrap();
+            let server = std::thread::spawn(move || {
+                let mut header = [0; 4];
+                peer.read_exact(&mut header).unwrap();
+                let mut request = vec![0; u32::from_be_bytes(header) as usize];
+                peer.read_exact(&mut request).unwrap();
+                let body = serde_json::to_vec(&response).unwrap();
+                peer.write_all(&(body.len() as u32).to_be_bytes()).unwrap();
+                peer.write_all(&body).unwrap();
+            });
+            let mut client = AgentClient::from_stream(client_stream);
+            let result = client.shutdown_with_deadline(Duration::from_secs(2));
+            server.join().unwrap();
+            assert_eq!(
+                result.is_ok(),
+                is_ok && (!require_ack || explicit_ack),
+                "{result:?}"
+            );
+            if require_ack && is_ok && !explicit_ack {
+                assert!(result
+                    .unwrap_err()
+                    .to_string()
+                    .contains("did not acknowledge shutdown"));
+            }
+        }
+    }
+
+    #[test]
+    fn retained_shutdown_accepts_only_explicit_ack() {
+        assert!(is_shutdown_ack(&AgentResponse::Ok {
+            data: Some(serde_json::json!({"shutdown": true})),
+        }));
+        for data in [
+            None,
+            Some(serde_json::json!({})),
+            Some(serde_json::json!({"shutdown": false})),
+            Some(serde_json::json!({"shutdown": "true"})),
+        ] {
+            assert!(!is_shutdown_ack(&AgentResponse::Ok { data }));
+        }
+        assert!(!is_shutdown_ack(&AgentResponse::Pong {
+            version: 1,
+            capabilities: vec![],
+        }));
+    }
+}
