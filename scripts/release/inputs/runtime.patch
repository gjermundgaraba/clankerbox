+    // Retained controllers stop with SMOLVM_STOP_REQUIRE_ACK=1; the guard is
+    // upstream behavior in both modes. Run with the variable set and absent.
+    // This is a disposable host sleep process, never a VM.
+    #[cfg(any(target_os = "linux", target_os = "macos"))]
+    #[test]
+    fn retained_shutdown_orphan_preserves_live_process_and_markers() {
+        use std::process::Command;
+        let temp = tempfile::tempdir().unwrap();
+        let storage = StorageDisk::open_or_create_at(&temp.path().join("storage.raw"), 1).unwrap();
+        let overlay = OverlayDisk::open_or_create_at(&temp.path().join("overlay.raw"), 1).unwrap();
+        let mut manager = AgentManager::new(temp.path(), storage, overlay).unwrap();
+        manager.vsock_socket = temp.path().join("missing.sock");
+        manager.pid_file = temp.path().join("agent.pid");
+        manager.config_file = temp.path().join("agent.config.json");
+        let mut child = Command::new("/bin/sleep").arg("60").spawn().unwrap();
+        let pid = child.id() as i32;
+        let start = process::process_start_time(pid).unwrap();
+        std::fs::write(&manager.pid_file, format!("{pid}\n{start}\n")).unwrap();
+        std::fs::write(&manager.config_file, "marker").unwrap();
+        let result = manager.stop();
+        let alive = process::is_alive(pid);
+        let pid_preserved = manager.pid_file.exists();
+        let config_preserved = manager.config_file.exists();
+        let _ = child.kill();
+        let _ = child.wait();
+        let error = result.unwrap_err().to_string();
+        assert!(error.contains("left the VM alive"), "{error}");
+        assert!(alive && pid_preserved && config_preserved);
+        // A dead process may always be cleaned up, even without an ACK.
+        manager.stop().unwrap();
+        assert!(!manager.pid_file.exists());
+    }
