+// The matching guest sends this only after sync_and_unmount_storage().
+fn is_shutdown_ack(response: &AgentResponse) -> bool {
+    matches!(response, AgentResponse::Ok { data: Some(data) }
+        if data.get("shutdown").and_then(serde_json::Value::as_bool) == Some(true))
