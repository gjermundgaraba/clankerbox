ARG BASE
ARG CA_BASE
FROM ${CA_BASE} AS certificates
FROM ${BASE}
ARG OWNER
LABEL clanker.owner=${OWNER}
COPY --from=certificates /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
RUN printf 'deb [check-valid-until=no] http://snapshot.ubuntu.com/ubuntu/20260901T000000Z/ noble main universe\ndeb [check-valid-until=no] http://snapshot.ubuntu.com/ubuntu/20260901T000000Z/ noble-updates main universe\ndeb [check-valid-until=no] http://snapshot.ubuntu.com/ubuntu/20260901T000000Z/ noble-security main universe\n' > /etc/apt/sources.list \
    && rm -f /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends qemu-system-x86 qemu-utils cloud-image-utils ca-certificates \
    && dpkg-query -W > /runner-packages.txt \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /work
