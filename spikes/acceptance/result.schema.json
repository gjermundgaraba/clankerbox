{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clankerbox spike result v1",
  "type": "object",
  "required": ["schema_version", "execution_scope", "status", "checks", "metrics", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "execution_scope": {"enum": ["vm", "local_process"]},
    "status": {"enum": ["pass", "fail", "not-run"]},
    "checks": {"type": "array", "items": {
      "type": "object", "required": ["name", "status"],
      "properties": {"name": {"type": "string"}, "status": {"enum": ["pass", "fail", "not-run"]}, "detail": {"type": "string"}}
    }},
    "metrics": {"type": "object", "additionalProperties": {"type": ["number", "null"]}},
    "evidence": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
