# Disposable upstream checkouts, binaries, images and test outputs.
.work/
bin/
spikes/*/.work/
spikes/*/.venv/
spikes/*/results/
spikes/recovery/*/.work/
spikes/recovery/*/results/
spikes/recovery/execute.lock
