{
  "name": "clankerbox",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "test": "vp run -r test",
    "ready": "vp check && vp run -r test && vp run -r build",
    "prepare": "vp config && effect-tsgo patch --no-typescript --oxlint"
  },
  "devDependencies": {
    "@clanker-stuff/oxlint-config": "catalog:",
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.12.0"
  }
}
