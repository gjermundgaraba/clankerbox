{
  "name": "clankerbox",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "check": "vp check",
    "test": "vp run -r test",
    "ready": "vp run check && vp run -r test && vp run -r build",
    "sea:build": "sh tools/release/build.sh",
    "sea:smoke": "sh tools/release/smoke.sh",
    "live:smolvm": "python3 tests/live/smolvm/driver.py",
    "live:tart": "python3 tests/live/tart/driver.py",
    "live:boat": "python3 tests/live/boat/driver.py"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.5.1"
}
